# ── OpenAI Configuration ──────────────────────────────────────────────────────
# Paste your OpenAI API key here (starts with sk-...)
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI model to use (default: gpt-4o-mini — cheap and fast)
# Other options: gpt-3.5-turbo, gpt-4o
OPENAI_MODEL=gpt-4o-mini

# ── Flask Configuration ───────────────────────────────────────────────────────
# Set to "production" when deploying; keep "development" for local testing
FLASK_ENV=development
FLASK_DEBUG=1
